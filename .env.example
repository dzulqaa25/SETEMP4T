# Firebase Configuration for Tongkrongan ST04
# Salin file ini menjadi .env.local dan isi dengan kredensial Firebase Project Anda.
# Jika belum diisi, aplikasi otomatis berjalan dalam Hybrid Local-Cloud Demo Mode dengan 100 data mahasiswa ST04.

NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tongkrongan-st04.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tongkrongan-st04"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tongkrongan-st04.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
