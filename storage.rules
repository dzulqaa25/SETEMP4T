rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Dokumen Kelas ST04 (Materi, Modul Praktikum, Soal Tahun Lalu, Template Laporan)
    match /dokumen/{folder}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024; // Max 25MB
    }

    // Foto Profil Buku Angkatan Mahasiswa
    match /avatars/{mahasiswaId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Lampiran Pengumuman
    match /lampiran/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
